<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CLINCAL ENGINEERING UNIT Service Log </title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{--bg:#f2f6f6;--card:#fff;--ink:#14262b;--mute:#5b6e73;--line:#d5e0e1;--teal:#0e7c86;--amber:#c98a14;--red:#b3402f}
@media(prefers-color-scheme:dark){:root{--bg:#0f1b1e;--card:#172629;--ink:#e6f0f1;--mute:#93a9ad;--line:#2a3f43;--teal:#3fb6c1;--amber:#e3a93a;--red:#e0705e}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 'IBM Plex Sans',system-ui,sans-serif}
header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:3px solid var(--teal);background:var(--card)}
h1{font-size:18px;margin:0;font-weight:600}
nav{display:flex;gap:4px}
nav button,.btn{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:7px 14px;border-radius:6px;cursor:pointer}
nav button.on,.btn.pri{background:var(--teal);border-color:var(--teal);color:#fff}
.btn.del{color:var(--red)}
main{padding:16px 20px;max-width:1280px;margin:auto}
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:16px}
label{display:flex;flex-direction:column;font-size:12px;color:var(--mute);gap:3px}
input,select,textarea{font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:6px;padding:7px;width:100%}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:16px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:12px}
.stat b{display:block;font-size:28px;font-weight:600}
.stat span{color:var(--mute);font-size:13px}
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:14px}
.panel h2{font-size:14px;margin:0 0 8px;font-weight:600}
.panel.wide{grid-column:1/-1}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{text-align:left;padding:8px;border-bottom:1px solid var(--line);white-space:nowrap}
td.wrap{white-space:normal;min-width:160px}
th{color:var(--mute);font-weight:500}
.tag{padding:2px 8px;border-radius:10px;background:var(--line);font-size:12px}
.tag.Repaired,.tag.Dispatched{background:var(--teal);color:#fff}
.tag.In\ repair,.tag.Received{background:var(--amber);color:#fff}
.tag.Beyond\ repair{background:var(--red);color:#fff}
.bar{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap}
dialog{border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);width:min(560px,94vw);padding:18px}
dialog form{display:grid;grid-template-columns:1fr 1fr;gap:10px}
dialog .full{grid-column:1/-1}
#login{max-width:340px;margin:12vh auto;display:grid;gap:10px;padding:20px}
.hide{display:none!important}
.empty{color:var(--mute);padding:20px;text-align:center}
</style>
</head>
<body>
<div id="login" class="panel hide">
  <h1>CEU Service Log</h1>
  <label>Email<input id="em" type="email" autocomplete="username"></label>
  <label>Password<input id="pw" type="password" autocomplete="current-password"></label>
  <button class="btn pri" onclick="signIn()">Sign in</button>
  <div id="lerr" style="color:var(--red)"></div>
</div>

<div id="app" class="hide">
<header>
  <h1>Clinical Engineering Unit: Service Log</h1>
  <nav>
    <button data-t="dash" class="on">Dashboard</button>
    <button data-t="svc">Service log</button>
    <button data-t="trn">Trainings</button>
    <button onclick="sb.auth.signOut()">Sign out</button>
  </nav>
</header>
<main>
  <div class="filters">
    <label>Year<select id="f_y"></select></label>
    <label>District<select id="f_d"></select></label>
    <label>Facility type<select id="f_t"></select></label>
    <label>Facility<input id="f_fac" placeholder="Search name"></label>
    <label>From<input id="f_from" type="date"></label>
    <label>To<input id="f_to" type="date"></label>
    <label id="f_s_wrap">Status<select id="f_s"></select></label>
    <label>&nbsp;<button class="btn" onclick="resetF()">Clear filters</button></label>
  </div>

  <section id="dash">
    <div class="cards" id="cards"></div>
    <div class="charts">
      <div class="panel"><h2>Equipment by district</h2><canvas id="c_dist"></canvas></div>
      <div class="panel"><h2>Equipment by facility type</h2><canvas id="c_type"></canvas></div>
      <div class="panel wide"><h2>Year-on-year comparison: equipment received per month</h2><canvas id="c_yoy" height="110"></canvas></div>
      <div class="panel wide"><h2>Yearly totals</h2><div class="tw" id="ytab"></div></div>
    </div>
  </section>

  <section id="svc" class="hide">
    <div class="bar"><button class="btn pri" onclick="openForm('service_records')">Add equipment</button><button class="btn" onclick="csv('service_records')">Export CSV</button></div>
    <div class="panel tw" id="svc_t"></div>
  </section>

  <section id="trn" class="hide">
    <div class="bar"><button class="btn pri" onclick="openForm('trainings')">Add training</button><button class="btn" onclick="csv('trainings')">Export CSV</button></div>
    <div class="panel tw" id="trn_t"></div>
  </section>
</main>
</div>

<dialog id="dlg"><form id="frm" onsubmit="save(event)"></form></dialog>

<script>
// 1. Paste your Supabase project values (Project Settings > API)
const SUPABASE_URL='https://gxudvqrreuywbtafndxb.supabase.co', SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd4dWR2cXJyZXV5d2J0YWZuZHhiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ0NzkxMDYsImV4cCI6MjExMDA1NTEwNn0.Gl7LLXgUzlFEgKFRTT64iJmdlXK6r9FV8Tq9vb8OIGk';

// 2. Edit these lists as needed
const DISTRICTS=['Ahanta West','Effia-Kwesimintsim','Ellembelle','Jomoro','Mpohor','Nzema East','Prestea-Huni Valley','Sekondi-Takoradi','Shama','Tarkwa-Nsuaem','Wassa Amenfi Central','Wassa Amenfi East','Wassa Amenfi West','Wassa East'];
const TYPES=['CHPS','Health Centre','Clinic','Polyclinic','District Hospital','Municipal Hospital','Regional Hospital','Other'];
const STATUS=['Received','In repair','Repaired','Dispatched','Beyond repair'];

const FIELDS={
 service_records:[['date_received','Date received','date',1],['facility','Facility','text',1],['facility_type','Facility type',TYPES],['district','District',DISTRICTS],['equipment','Equipment','text',1],['model','Model','text'],['serial_number','Serial number','text'],['status','Status',STATUS],['problem','Problem','area'],['part_replaced','Part replaced','text'],['date_dispatched','Date dispatched','date'],['comments','Comments','area']],
 trainings:[['training_date','Date','date',1],['facility','Facility','text'],['facility_type','Facility type',TYPES],['district','District',DISTRICTS],['equipment','Equipment trained on','text',1],['trainees','No. of trainees','number',1],['venue','Venue','text'],['remarks','Comments / remarks','area']]
};
const DATE={service_records:'date_received',trainings:'training_date'};
const sb=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const Y=d=>d?+d.slice(0,4):0;
const data={service_records:[],trainings:[]};
let charts={},editing=null,tab='dash';
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const COL=['#0e7c86','#c98a14','#6b5fb5','#b3402f','#4a8f3c','#a64d79','#3b6ea5','#8a8a2e'];

async function signIn(){const {error}=await sb.auth.signInWithPassword({email:$('em').value,password:$('pw').value});if(error)$('lerr').textContent=error.message}
sb.auth.onAuthStateChange((_e,s)=>{$('login').classList.toggle('hide',!!s);$('app').classList.toggle('hide',!s);if(s)load()});
sb.auth.getSession().then(({data:{session}})=>{if(!session)$('login').classList.remove('hide')});

async function load(){
  for(const t of Object.keys(data)){
    const r=await sb.from(t).select('*').order(DATE[t],{ascending:false});
    if(r.error){alert('Could not load '+t+': '+r.error.message);return}
    data[t]=r.data;
  }
  fillFilters();render();
}
function opts(a,first){return '<option value="">'+first+'</option>'+a.map(x=>`<option>${esc(x)}</option>`).join('')}
function fillFilters(){
  const ys=[...new Set([...data.service_records.map(r=>Y(r.date_received)),...data.trainings.map(r=>Y(r.training_date))].filter(Boolean))].sort((a,b)=>b-a);
  const keep=$('f_y').value;
  $('f_y').innerHTML=opts(ys,'All years');$('f_y').value=keep;
  if(!$('f_d').options.length){$('f_d').innerHTML=opts(DISTRICTS,'All districts');$('f_t').innerHTML=opts(TYPES,'All types');$('f_s').innerHTML=opts(STATUS,'All statuses')}
}
function F(){return{y:$('f_y').value,d:$('f_d').value,t:$('f_t').value,fac:$('f_fac').value.toLowerCase(),from:$('f_from').value,to:$('f_to').value,s:$('f_s').value}}
function pass(t,r,skipYear){
  const f=F(),dt=r[DATE[t]];
  return (skipYear||!f.y||Y(dt)==f.y)&&(!f.d||r.district===f.d)&&(!f.t||r.facility_type===f.t)&&(!f.fac||(r.facility||'').toLowerCase().includes(f.fac))&&(!f.from||dt>=f.from)&&(!f.to||dt<=f.to)&&(t!=='service_records'||!f.s||r.status===f.s);
}
const rows=t=>data[t].filter(r=>pass(t,r));
function resetF(){['f_y','f_d','f_t','f_fac','f_from','f_to','f_s'].forEach(i=>$(i).value='');render()}
document.querySelectorAll('.filters select,.filters input').forEach(e=>e.addEventListener('input',render));
document.querySelectorAll('nav button[data-t]').forEach(b=>b.onclick=()=>{
  tab=b.dataset.t;document.querySelectorAll('nav button[data-t]').forEach(x=>x.classList.toggle('on',x===b));
  ['dash','svc','trn'].forEach(s=>$(s).classList.toggle('hide',s!==tab));
  $('f_s_wrap').classList.toggle('hide',tab==='trn');render();
});

function count(a,key){const m={};a.forEach(r=>{const k=r[key]||'Not specified';m[k]=(m[k]||0)+1});return m}
function draw(id,cfg){if(charts[id])charts[id].destroy();charts[id]=new Chart($(id),cfg)}

function render(){
  const sr=rows('service_records'),tr=rows('trainings');
  if(tab==='dash'){
    const rep=sr.filter(r=>['Repaired','Dispatched'].includes(r.status)).length;
    const disp=sr.filter(r=>r.status==='Dispatched').length;
    const pend=sr.filter(r=>['Received','In repair'].includes(r.status)).length;
    const st=(n,l)=>`<div class="stat"><b>${n}</b><span>${l}</span></div>`;
    $('cards').innerHTML=st(sr.length,'Received')+st(rep,'Repaired')+st(disp,'Dispatched')+st(pend,'Still in workshop')+st(tr.length,'Trainings')+st(tr.reduce((a,r)=>a+(+r.trainees||0),0),'Trainees');
    const d=count(sr,'district');
    draw('c_dist',{type:'doughnut',data:{labels:Object.keys(d),datasets:[{data:Object.values(d),backgroundColor:Object.keys(d).map((_,i)=>COL[i%COL.length]),borderWidth:1}]},options:{plugins:{legend:{position:'right',labels:{boxWidth:12}}}}});
    const t=count(sr,'facility_type');
    draw('c_type',{type:'bar',data:{labels:Object.keys(t),datasets:[{label:'Equipment',data:Object.values(t),backgroundColor:COL[0]}]},options:{indexAxis:'y',plugins:{legend:{display:false}}}});
    const all=data.service_records.filter(r=>pass('service_records',r,true));
    const yrs=[...new Set(all.map(r=>Y(r.date_received)))].sort();
    draw('c_yoy',{type:'line',data:{labels:MON,datasets:yrs.map((y,i)=>({label:y,borderColor:COL[i%COL.length],backgroundColor:COL[i%COL.length],tension:.25,data:MON.map((_,m)=>all.filter(r=>Y(r.date_received)===y&&+r.date_received.slice(5,7)===m+1).length)}))},options:{scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});
    let h='<table><tr><th>Year</th><th>Received</th><th>Repaired</th><th>Dispatched</th><th>Trainings</th><th>Trainees</th></tr>';
    const ty=[...new Set([...yrs,...data.trainings.filter(r=>pass('trainings',r,true)).map(r=>Y(r.training_date))])].sort((a,b)=>b-a);
    ty.forEach(y=>{const a=all.filter(r=>Y(r.date_received)===y),b=data.trainings.filter(r=>pass('trainings',r,true)&&Y(r.training_date)===y);
      h+=`<tr><td>${y}</td><td>${a.length}</td><td>${a.filter(r=>['Repaired','Dispatched'].includes(r.status)).length}</td><td>${a.filter(r=>r.status==='Dispatched').length}</td><td>${b.length}</td><td>${b.reduce((s,r)=>s+(+r.trainees||0),0)}</td></tr>`});
    $('ytab').innerHTML=h+'</table>';
  }
  if(tab==='svc')table('svc_t','service_records',sr,['date_received','facility','facility_type','district','equipment','model','serial_number','problem','part_replaced','status','date_dispatched','comments']);
  if(tab==='trn')table('trn_t','trainings',tr,['training_date','facility','facility_type','district','equipment','trainees','venue','remarks']);
}
function table(el,t,a,cols){
  const lab=Object.fromEntries(FIELDS[t].map(f=>[f[0],f[1]]));
  if(!a.length){$(el).innerHTML='<div class="empty">No records match these filters. Use Add to create the first one.</div>';return}
  $(el).innerHTML='<table><tr>'+cols.map(c=>`<th>${lab[c]}</th>`).join('')+'<th></th></tr>'+a.map(r=>'<tr>'+cols.map(c=>{
    const v=c==='status'?`<span class="tag ${esc(r[c])}">${esc(r[c])}</span>`:esc(r[c]);
    return `<td class="${['problem','comments','remarks'].includes(c)?'wrap':''}">${v}</td>`}).join('')+`<td><button class="btn" onclick="openForm('${t}','${r.id}')">Edit</button> <button class="btn del" onclick="del('${t}','${r.id}')">Delete</button></td></tr>`).join('')+'</table>';
}
function openForm(t,id){
  editing={t,id};const r=id?data[t].find(x=>x.id===id):{};
  $('frm').innerHTML=`<h2 class="full" style="margin:0">${id?'Edit':'Add'} ${t==='trainings'?'training':'equipment'}</h2>`+FIELDS[t].map(([k,l,ty,req])=>{
    const v=r[k]??(k==='status'?'Received':'');const full=ty==='area'?'full':'';
    const inp=Array.isArray(ty)?`<select name="${k}" ${req?'required':''}><option value=""></option>${ty.map(o=>`<option ${o===v?'selected':''}>${esc(o)}</option>`).join('')}</select>`
      :ty==='area'?`<textarea name="${k}" rows="2">${esc(v)}</textarea>`:`<input name="${k}" type="${ty}" value="${esc(v)}" ${ty==='number'?'min="0"':''} ${req?'required':''}>`;
    return `<label class="${full}">${l}${req?' *':''}${inp}</label>`}).join('')+
    '<div class="full bar"><button class="btn pri">Save</button><button type="button" class="btn" onclick="$(\'dlg\').close()">Cancel</button></div>';
  $('dlg').showModal();
}
async function save(e){
  e.preventDefault();const {t,id}=editing,body={};
  new FormData($('frm')).forEach((v,k)=>body[k]=v===''?null:v);
  if(body.trainees!=null)body.trainees=+body.trainees;
  const q=id?sb.from(t).update(body).eq('id',id):sb.from(t).insert(body);
  const {error}=await q;if(error){alert('Could not save: '+error.message);return}
  $('dlg').close();await load();
}
async function del(t,id){
  if(!confirm('Delete this record? This cannot be undone.'))return;
  const {error}=await sb.from(t).delete().eq('id',id);if(error)alert(error.message);else load();
}
function csv(t){
  const a=rows(t),c=FIELDS[t].map(f=>f[0]);
  const s=[FIELDS[t].map(f=>f[1]),...a.map(r=>c.map(k=>r[k]))].map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n');
  const l=document.createElement('a');l.href=URL.createObjectURL(new Blob([s],{type:'text/csv'}));l.download=t+'_'+new Date().toISOString().slice(0,10)+'.csv';l.click();
}
</script>
</body>
</html>
